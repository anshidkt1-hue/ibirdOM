# WhatsApp Business API Credentials (real values go in whatsapp-backend/.env and Render, never here)
WHATSAPP_PHONE_NUMBER=+919778598582
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-whatsapp-business-account-id
# Meta Commerce catalog linked to the WhatsApp account (one product list with photos + in-chat cart)
WHATSAPP_CATALOG_ID=your-catalog-id
WHATSAPP_ACCESS_TOKEN=your-access-token
WHATSAPP_APP_SECRET=your-app-secret
WHATSAPP_VERIFY_TOKEN=your-verify-token

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Webhook Configuration
WEBHOOK_URL=https://yourdomain.com/api/whatsapp/webhook
WEBHOOK_VERIFY_TOKEN=your-verify-token

# API Configuration
API_BASE_URL=https://graph.facebook.com/v21.0

# Dashboard login for local testing (employee email + password)
TEST_LOGIN_EMAIL=
TEST_LOGIN_PASSWORD=
